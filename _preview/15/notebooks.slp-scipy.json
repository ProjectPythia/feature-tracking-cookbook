esky":"@brianejrose.bsky.social","linkedin":"https://www.linkedin.com/in/brian-rose-37bb55106/"}],"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","free":true,"osi":true}},"github":"https://github.com/projectpythia/feature-tracking-cookbook","copyright":"2026","affiliations":[{"id":"UAlbany","name":"University at Albany (SUNY)","department":"Atmospheric and Environmental Sciences","url":"https://www.albany.edu/daes"},{"id":"Univerity of California, Berkeley","name":"Univerity of California, Berkeley"},{"id":"University of Miami","name":"University of Miami"},{"id":"University of California, San Diego","name":"University of California, San Diego"},{"id":"Tuskegee University","name":"Tuskegee University"},{"id":"CISL","name":"NSF National Center for Atmospheric Research","department":"Computational and Information Systems Lab","url":"https://www.cisl.ucar.edu"},{"id":"Unidata","name":"NSF Unidata","url":"https://www.unidata.ucar.edu"},{"id":"Argonne","name":"Argonne National Laboratory","department":"Environmental Science Division","url":"https://www.anl.gov/evs"},{"id":"CarbonPlan","name":"CarbonPlan","url":"https://carbonplan.org"},{"id":"NVIDIA","name":"NVIDIA Corporation","url":"https://www.nvidia.com/"}],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/projectpythia/feature-tracking-cookbook/blob/main/notebooks/SLP_scipy.ipynb","edit_url":"https://github.com/projectpythia/feature-tracking-cookbook/edit/main/notebooks/SLP_scipy.ipynb","exports":[{"format":"ipynb","filename":"SLP_scipy.ipynb","url":"/feature-tracking-cookbook/_preview/15/build/SLP_scipy-737d92f95f9ce4efc1ef6bc7ea318ebb.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\nimport numpy as np\nfrom scipy.ndimage import minimum_filter\nfrom scipy.ndimage import label, generate_binary_structure\nimport matplotlib.pyplot as plt\nimport matplotlib as mpl","key":"cGZTakDppS"},{"type":"outputs","id":"vr15QFinH3KlroVFZGxsn","children":[],"key":"lFV5LVy5Hi"}],"key":"Whm6vENb2Q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def crosses_dateline(labeled_arr, resolution):\n    #Shift 180 degrees\n    shifted_arr = np.roll(labeled_arr, 180*resolution, axis = 1)\n\n    #Examine a 3x3 region centered at the dateline\n    for lat in range(0, len(shifted_arr) - 1):\n    \tsample_arr = shifted_arr[lat:lat+2, 179:181]\n\n    \ttop_left = sample_arr[0, 0]\n    \ttop_right = sample_arr[0, 1]\n    \tbottom_right = sample_arr[1, 1]\n    \tbottom_left = sample_arr[1, 0]\n\t\t\n    \t#Compare top left with position next to it\n    \tif(top_left != 0 and top_right != 0):\n    \t\tif(top_left != top_right):\n    \t\t\tnum_to_change = top_left\n    \t\t\tshifted_arr = np.where(shifted_arr != num_to_change, shifted_arr, top_right)\n    \t\t\tsample_arr = shifted_arr[lat:lat+2, 179:181]\n\n    \t#Compare top left with position diagonal to it\n    \tif(top_left != 0 and bottom_right != 0):\n    \t\tif(top_left != bottom_right):\n    \t\t\tnum_to_change = top_left\n    \t\t\tshifted_arr = np.where(shifted_arr != num_to_change, shifted_arr, bottom_right)\n    \t\t\tsample_arr = shifted_arr[lat:lat+2, 179:181]\n\t\t\n    \t#Compate bottom left with position next to it\n    \tif(bottom_left != 0 and bottom_right != 0):\n    \t\tif(bottom_left != bottom_right):\n    \t\t\tnum_to_change = bottom_left\n    \t\t\tshifted_arr = np.where(shifted_arr != num_to_change, shifted_arr, bottom_right)\n    \t\t\tsample_arr = shifted_arr[lat:lat+2, 179:181]\n    \t\t\t#print('Changed arr bot left, bot right', sample_arr)\n    \t\n    \t#Compare bottom left with position diagonal to it\n    \tif(bottom_left != 0 and top_right != 0):\n    \t\tif(bottom_left != top_right):\n    \t\t\tnum_to_change = bottom_left\n    \t\t\tshifted_arr = np.where(shifted_arr != num_to_change, shifted_arr, top_right)\n    \t\t\tsample_arr = shifted_arr[lat:lat+2, 179:181]\n    \t\t\n    return np.roll(shifted_arr, 180, axis = 1)\n    \n    ","key":"zjyTfpHRxe"},{"type":"outputs","id":"Mc5GfvnVe-DzmPtFWYl-k","children":[],"key":"aXwuSube70"}],"key":"otEzaRdVvk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds = xr.open_dataset('../notebooks/data/SLP_ex.nc')","key":"dzL6m6jERv"},{"type":"outputs","id":"oJzsN4x-pKoGFb2qesmqB","children":[],"key":"lwVztAmWcq"}],"key":"UKluFNnNi1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ds\n\n#Just plot a sample time step of MSLP. Could also plot a loop\nplt.pcolormesh(ds[\"longitude\"].values, ds[\"latitude\"].values, ds['SLP'].values[0])\nplt.colorbar()","key":"USxI8Q5dwT"},{"type":"outputs","id":"aQHMH2BLdyi0s-Acz7Jrh","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"59a2ee35f40383d54802e6bc40a78f56","path":"/feature-tracking-cookbook/_preview/15/build/59a2ee35f40383d54802e6bc40a78f56.png"}}},"key":"bYnofcvsHB"}],"key":"hSfqsJVZaR"}],"key":"sg71uWf6nE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"SLP = ds['SLP']\n\nSLP_hPa = SLP / 100","key":"LPNQn7p6WR"},{"type":"outputs","id":"CP-m4iA1SzGzu6NHs4p6W","children":[],"key":"djkIFwLGmc"}],"key":"kYDLVaiMdt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"SLP_arr = SLP_hPa.to_numpy()","key":"A0S1MGZjX5"},{"type":"outputs","id":"UrO9ig4UbXlRMqYdNAQEW","children":[],"key":"AxsjTTn3Gj"}],"key":"tuOLc52hcq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(SLP_arr)","key":"GDH70tiMGF"},{"type":"outputs","id":"OeTcipBdL-o2eMhj25ZqF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"[[[1010.22898851 1010.22610959 1010.22610959 ... 1010.23186743\n   1010.22898851 1010.22898851]\n  [1010.28080909 1010.28656693 1010.29088532 ... 1010.26065664\n   1010.26785395 1010.27361179]\n  [1009.56683662 1009.59850476 1009.62729397 ... 1009.47327168\n   1009.50493982 1009.53660795]\n  ...\n  [ 994.87570155  994.87570155  994.87282263 ...  994.83107827\n    994.84979126  994.86562532]\n  [ 995.68611788  995.68323895  995.68036003 ...  995.69331518\n    995.69187572  995.6889968 ]\n  [ 996.0690144   996.07477224  996.0762117  ...  996.06325656\n    996.06613548  996.06613548]]\n\n [[1010.00011427 1009.99723535 1009.99723535 ... 1010.00011427\n   1010.00011427 1010.00011427]\n  [1010.13254465 1010.13830249 1010.14262087 ... 1010.11383166\n   1010.1195895  1010.1267868 ]\n  [1009.54668418 1009.57547339 1009.60138368 ... 1009.45599816\n   1009.48334791 1009.51501604]\n  ...\n  [ 994.21642858  994.22506535  994.22794427 ...  994.14589501\n    994.17468423  994.20059452]\n  [ 995.02396599  995.02396599  995.02684491 ...  995.01964761\n    995.02108707  995.02396599]\n  [ 995.46012256  995.46156202  995.46731986 ...  995.45148579\n    995.45436472  995.45724364]]\n\n [[1010.03897971 1010.03897971 1010.03897971 ... 1010.04185863\n   1010.04185863 1010.03897971]\n  [1010.15413656 1010.15845494 1010.16421278 ... 1010.13254465\n   1010.13830249 1010.14549979]\n  [1009.54668418 1009.57547339 1009.60138368 ... 1009.45743762\n   1009.48334791 1009.51501604]\n  ...\n  [ 993.58882375  993.59170267  993.58882375 ...  993.53124533\n    993.55715562  993.57874753]\n  [ 994.27976485  994.28264