ey":"VcXhUBItCh"}],"key":"tvj6ghCdZQ"},{"type":"tableCell","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[],"key":"ml4r3mYaqc"}],"key":"FHdwT8RqYR"},{"type":"tableRow","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"link","url":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"IPython","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"IUvtdJQa60"}],"urlSource":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","key":"wu9SE9vCDO"}],"key":"hQ749S1I4H"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Useful","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"m9fWzVNJNN"}],"key":"DDYHRzWCSf"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For inline animation","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Kt80aazpuf"}],"key":"GtZkUcCD62"}],"key":"wmOc5o8LeV"}],"key":"TGdJ4VmCeG"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Time to learn","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"RhSSXn6ygO"}],"key":"VvLJHkjyIL"},{"type":"text","value":": 30 minutes","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"qjtSx0rdXr"}],"key":"oXtrEnNSQl"}],"key":"ouWLmctTe3"}],"key":"XNKciDVugT"}],"key":"SNVsJqP4r5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nfrom matplotlib.animation import FuncAnimation\nfrom IPython.display import HTML\nfrom skimage.measure import label, regionprops\nimport matplotlib.colors as mcolors\nfrom matplotlib.cm import ScalarMappable\nimport cartopy.crs as ccrs","key":"aayLk9651C"},{"type":"outputs","id":"bT0eQaqNZeSjMh9-e0wNj","children":[],"key":"ZHFmTRD2O2"}],"key":"rsnwBZP3Sb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\n\nds = xr.open_dataset(\"data/SLP_ex.nc\")\nda = ds[\"SLP\"]\n\nthreshold = 100000\nmin_area = 20\nmin_overlap = 0.2  \n\n\n\n# ---- get lat/lon coords ----\n# assumes dims like (time, lat, lon)\nlat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)\n","key":"qk8U5xzTzq"},{"type":"outputs","id":"U8Uwnk_Vm9Toh8p043LRk","children":[],"key":"gT9e2K89Zv"}],"key":"thtBFkc8qv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(field, threshold=100000, min_area=20):\n    mask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"XbCA5HKI6s"},{"type":"outputs","id":"QwoEgfHqJ-oSxCglYDg31","children":[],"key":"YDvJPgNOgI"}],"key":"vkvkTZIHW8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"R0vbXAWJnq"},{"type":"outputs","id":"iDX1ypYDahhfyMFT5owfK","children":[],"key":"zQnmh0ENnW"}],"key":"RV9yCpFXln"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"JVYYVKi2Qr"},{"type":"outputs","id":"JWd8AtS9MFwej18JEjPkN","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/feature-tracking-dev/lib/python3.14/site-packages/cartopy/io/__init__.py:242: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/110m_physical/ne_110m_coastline.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"LsLCE1pbxh"},{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"21a6df7f79a5b2f42b15281624e86165","path":"/feature-tracking-cookbook/_preview/40/build/21a6df7f79a5b2f42b15281624e86165.html"}}},"key":"TBJ9Ubqsnj"}],"key":"Gx3IMuSviM"}],"key":"eVJwRU6JFT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Wf3r7bRsio"},{"type":"outputs","id":"Nq2---R0Ic4dgi2uv9nVP","children":[],"key":"psDtTzYN5Y"}],"key":"dM0W1jQOn7"}],"key":"RxXtdn9mJ9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Sea Level Pressure (SLP) Feature Tracking using SCIPY","url":"/notebooks/slp-scipy","group":"Sea Level Pressure Tracking"},"next":{"title":"Sea Level Pressure Identification and Tracking with Precipitation : Scikit","url":"/notebooks/scikit-slp-precip","group":"Combined Tracking"}}},"domain":"http://localhost:3000"}