ey":"wk5DjQ2OQM"}],"key":"YyBjS8sJvH"},{"type":"tableCell","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[],"key":"TImdlRbFq4"}],"key":"DUkz92fSuJ"},{"type":"tableRow","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"link","url":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"IPython","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"yO2W2fhjmK"}],"urlSource":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","key":"X1iWyShn2h"}],"key":"St549XUU9P"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Useful","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"o051dH3dHs"}],"key":"RPSlVK0Kvx"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For inline animation","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"GryebyHzdq"}],"key":"JbUAMRjWGA"}],"key":"eT3d0kXDB3"}],"key":"jt2nGIbJg3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Time to learn","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"eeXDLyrXC3"}],"key":"kRjaq7OUnb"},{"type":"text","value":": 30 minutes","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"WCFcthVPFw"}],"key":"qkz85BR81F"}],"key":"cdvuyLHvY8"}],"key":"sIfqNOqjOW"}],"key":"l0HerPTtg2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nfrom matplotlib.animation import FuncAnimation\nfrom IPython.display import HTML\nfrom skimage.measure import label, regionprops\nimport matplotlib.colors as mcolors\nfrom matplotlib.cm import ScalarMappable\nimport cartopy.crs as ccrs","key":"RDoeaEZsZH"},{"type":"outputs","id":"RjUSGBV6LcGuNJqC-63DR","children":[],"key":"wkjXGBHkwh"}],"key":"oxwf1MDsxa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\n\nds = xr.open_dataset(\"data/SLP_ex.nc\")\nda = ds[\"SLP\"]\n\nthreshold = 100000\nmin_area = 20\nmin_overlap = 0.2  \n\n\n\n# ---- get lat/lon coords ----\n# assumes dims like (time, lat, lon)\nlat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)\n","key":"ZnL3eria7o"},{"type":"outputs","id":"L0L0SGr2xhOmg2K-vCMG-","children":[],"key":"DaEVpB4gUw"}],"key":"KRqqjbdNXP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(field, threshold=100000, min_area=20):\n    mask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"HXJPjZlYFK"},{"type":"outputs","id":"N99jaNlIcmHdZciGuqlTG","children":[],"key":"a8xZkBfdZb"}],"key":"pyiHQyNLN8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"g5sigYsTPV"},{"type":"outputs","id":"ligCGaqlZEv7gZh_aZ2Xc","children":[],"key":"FWhF9ZsgER"}],"key":"YnpnU7K75Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"eALJ3sSmrl"},{"type":"outputs","id":"He5twbw0QgufBEQ0-Vzas","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"968793a90b8bd35cd9a865c2b676ed82","path":"/feature-tracking-cookbook/_preview/42/build/968793a90b8bd35cd9a865c2b676ed82.html"}}},"key":"LunCINA8aa"}],"key":"uL9ZcxXOBn"}],"key":"mJOHkHRC2p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"qBqK8XmclX"},{"type":"outputs","id":"EK7FZoZq3yuCuOkie-SmV","children":[],"key":"wFQ6kfsswb"}],"key":"S2BJ9bmGuX"}],"key":"batjCWm1Xm"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Sea Level Pressure (SLP) Feature Tracking using SCIPY","url":"/notebooks/slp-scipy","group":"Sea Level Pressure Tracking"},"next":{"title":"Sea Level Pressure Identification and Tracking with Precipitation : Scikit","url":"/notebooks/scikit-slp-precip","group":"Combined Tracking"}}},"domain":"http://localhost:3000"}