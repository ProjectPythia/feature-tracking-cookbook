ecutable":true,"value":"threshold = 100000\nmin_area = 20\nmin_overlap = 0.2  ","key":"jVDkc9tuwh"},{"type":"outputs","id":"9shUwjiWJw5V8vrSGNwBX","children":[],"key":"iWNaG5QsQC"}],"key":"XlAKmYGe9F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get the latitude and longitude 2d meshgrid for plotting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wzTWl9yakU"}],"identifier":"get-the-latitude-and-longitude-2d-meshgrid-for-plotting","label":"Get the latitude and longitude 2d meshgrid for plotting","html_id":"get-the-latitude-and-longitude-2d-meshgrid-for-plotting","implicit":true,"key":"EQCdZ2HZ0r"}],"key":"UGRRQDJNOj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"To plot SLP with contour(), we first create 2D latitude–longitude grids.\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q3lvqZvKA2"},{"type":"inlineCode","value":"SLP","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QXLWeosEBG"},{"type":"text","value":" : 1° × 1°","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NaeBL25IGf"}],"key":"PTZSwB3z7a"}],"key":"AAgKedMjui"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"lat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)","key":"golMHlHd6g"},{"type":"outputs","id":"FqrswD8AqP5OUmj-Pw74T","children":[],"key":"LckhOcB2N2"}],"key":"G137nIeO2g"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select low SLP features less than a threshold using matplotlib contour()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NbWcllS57f"}],"identifier":"select-low-slp-features-less-than-a-threshold-using-matplotlib-contour","label":"Select low SLP features less than a threshold using matplotlib contour()","html_id":"select-low-slp-features-less-than-a-threshold-using-matplotlib-contour","implicit":true,"key":"gPGdhdeha2"}],"key":"GGsFCxz2NX"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This function detects low-pressure SLP features from a single time step using Matplotlib contours. First, it draws the contour line at the chosen SLP threshold, such as 1000 or 1005 hPa. Each closed contour segment is then converted into a filled polygon mask, which marks the grid cells inside that contour. Since we only want low-pressure systems, the mask is further restricted to grid points where SLP <= ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZbP8wawg97"},{"type":"inlineCode","value":"threshold","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AJLg4eTdYq"},{"type":"text","value":". Very small objects are removed using the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LQiFVraWaJ"},{"type":"inlineCode","value":"min_area","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GC7DDoepBG"},{"type":"text","value":" limit. For each remaining feature, the function stores a frame-specific feature_id, the feature mask, and its centroid location as row and column indices.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i8ADnQlaqU"}],"key":"Tovlf7IJ7E"}],"key":"BEoBlSakrV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features_matplotlib(field, threshold=100000, min_area=20):\n    ny, nx = field.shape\n\n    yy, xx = np.mgrid[0:ny, 0:nx]\n    points = np.column_stack([xx.ravel(), yy.ravel()])\n\n    # Draw contour at the SLP threshold\n    fig, ax = plt.subplots()\n    cs = ax.contour(field, levels=[threshold])\n    plt.close(fig)\n\n    features = []\n    feature_id = 1\n\n    for seg in cs.allsegs[0]:\n\n        if len(seg) < 3:\n            continue\n\n        path = Path(seg)\n\n        # Convert contour polygon into a filled mask\n        mask = path.contains_points(points).reshape(ny, nx)\n\n        # Keep only the low-pressure side of the contour\n        mask = mask & (field <= threshold)\n\n        # Remove tiny features\n        if mask.sum() < min_area:\n            continue\n\n        # Centroid from mask grid cells\n        y, x = np.where(mask)\n        centroid = (y.mean(), x.mean())   # row, col\n\n        features.append({\n            \"feature_id\": feature_id,\n            \"mask\": mask,\n            \"centroid_rc\": centroid,\n        })\n\n        feature_id += 1\n\n    return features","key":"kZkndhhZXV"},{"type":"outputs","id":"D9teWmTFFozN-ng_JUtLd","children":[],"key":"TIZiSfg375"}],"key":"R5ur0Zxyix"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test it out for the first time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bMWMEN8OMg"}],"identifier":"test-it-out-for-the-first-time-step","label":"Test it out for the first time step","html_id":"test-it-out-for-the-first-time-step","implicit":true,"key":"Pgfpqk6Bxd"}],"key":"GdwQYe5Q4S"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s take a look at the labelled feature at time = 0 which at 2022 November 1 00:00 UTC.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dypP4Hb7QK"}],"key":"ra3p4DNC9x"}],"key":"k9NKY37J3l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = 0\nslp = da.isel(time=t).values","key":"ehmVEoTXTH"},{"type":"outputs","id":"I7Ax4UsvbR8Pe9lNMIiX4","children":[],"key":"vwC5P9yQMB"}],"key":"eT6rFBaspk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We call the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HZwzkN0tDl"},{"type":"inlineCode","value":"detect_features_matplotlib()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JvTbahufKh"},{"type":"text","value":" function with the parameters set above","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"woK7uwJaR1"}],"key":"gQdIAy1vwi"}],"key":"UOut6jZYEb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"labels = detect_features_matplotlib(slp, threshold=threshold, min_area=min_area)","key":"wSzAyaULrU"},{"type":"outputs","id":"rafbEczzqjAdEqvmbpuKT","children":[],"key":"uRVqEQp3Dh"}],"key":"AuKA1Poaky"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"levels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\n# colored SLP contour lines\nax.contour(\n    lon2d, lat2d, slp,\n    levels=levels,\n    cmap=\"turbo\",\n    linewidths=0.9,\n    transform=ccrs.PlateCarree()\n)\n\n\nfor feat in labels:\n\n    mask = feat[\"mask\"]\n\n    ax.contour(\n        lon2d,\n        lat2d,\n        mask.astype(int),\n        levels=[0.5],\n        colors=\"black\",\n        linewidths=1.6,\n        transform=ccrs.PlateCarree()\n    )\n\n    y, x = feat[\"centroid_rc\"]   # row, column\n    iy = int(round(y))\n    ix = int(round(x))\n\n    ax.plot(\n        lon[ix],\n        lat[iy],\n        \"ko\",\n        ms=3,\n        transform=ccrs.PlateCarree()\n    )\n\n    ax.text(\n        lon[ix],\n        lat[iy],\n        str(feat[\"feature_id\"]),\n        fontsize=8,\n        color=\"black\",\n        ha=\"left\",\n        va=\"bottom\",\n        transform=ccrs.PlateCarree(),\n        bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n    )\n\n\nax.coastlines(color=\"0.55\", linewidth=0.6)\n\ngl = ax.gridlines(\n    draw_labels=True,\n    linewidth=0.4,\n    color=\"0.5\",\n    alpha=0.25,\n    linestyle=\"--\"\n)\ngl.top_labels = False\ngl.right_labels = False\n\nax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nplt.show()\n","key":"JCSK3HpA78"},{"type":"outputs","id":"ywWSSDjR6n9sju8hu9P0A","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"cc52eba52e9be90b3b079bd35a74c7cf","path":"/feature-tracking-cookbook/_preview/45/build/cc52eba52e9be90b3b079bd35a74c7cf.png"}}},"key":"LT2lKkNdTi"}],"key":"FzeeW4pXJM"}],"key":"E6Epqc9kVV"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"Aw29mjv2eW"}],"key":"mZRazW20Ln"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This method presents a visual seam near 0/360 longitude","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WVwZHqFJL4"}],"key":"YVVgnrCkAc"}],"key":"o8NnWjBxjW"}],"key":"cWZIJcFM8r"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s track SLP Features Over Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tSaVItHKXg"}],"identifier":"lets-track-slp-features-over-time","label":"Let’s track SLP Features Over Time","html_id":"lets-track-slp-features-over-time","implicit":true,"key":"VCFanCNVTw"}],"key":"LXXGkmyQUy"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This function tracks the Matplotlib-detected SLP features through time. It starts with an empty list to store the tracked features, an empty dictionary to store features from the previous time step, and a counter for assigning new ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QoYY4ZGiKD"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lON2MAfgrg"},{"type":"text","value":" values. For each time step, the function first detects the low-pressure features using ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZmaBTjAAIx"},{"type":"inlineCode","value":"detect_features_matplotlib()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j1e0tCwdsS"},{"type":"text","value":". It then compares each current feature mask with the masks from the previous time step. The overlap is calculated as the fraction of the current feature that overlaps with an older feature. If the overlap is larger than the chosen min_overlap threshold, the current feature keeps the same ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JYu2jyotAN"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hXIzuWy5Xo"},{"type":"text","value":". If there is not enough overlap, the feature is treated as a new object and receives a new ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PQ69mPJZRW"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Nchz7sMqCq"},{"type":"text","value":". For each frame, the function stores the persistent ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A1DLSl0DfR"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DVoIwycRwh"},{"type":"text","value":", the frame-specific feature_id, the centroid location, the mask, and the overlap value. The final output is a time-ordered list of tracked SLP features that can be used for plotting or animation.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PWsIHf46xk"}],"key":"JWPYiIUlvU"}],"key":"LR6NmEcvf0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def track_slp_features_matplotlib(\n    da,\n    threshold=100000,\n    min_area=20,\n    min_overlap=0.2,\n):\n    \"\"\"\n    Track SLP low-pressure features detected using Matplotlib contours.\n\n    Tracking rule:\n        A feature keeps the same track_id if it overlaps enough\n        with a feature from the previous time step.\n    \"\"\"\n\n    tracked = []\n    prev = {}\n    next_track_id = 1\n\n    for t in range(da.sizes[\"time\"]):\n\n        field = da.isel(time=t).values\n\n        # Detect features at this time step\n        features = detect_features_matplotlib(\n            field,\n            threshold=threshold,\n            min_area=min_area\n        )\n\n        current = {}\n        frame_info = []\n\n        for feat in features:\n\n            mask = feat[\"mask\"]\n\n            best_id = None\n            best_overlap = 0.0\n\n            for track_id, old_mask in prev.items():\n\n                overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n\n                if overlap > best_overlap:\n                    best_overlap = overlap\n                    best_id = track_id\n\n            # Assign new ID if no strong overlap with previous features\n            if best_overlap < min_overlap:\n                best_id = next_track_id\n                next_track_id += 1\n\n            current[best_id] = mask\n\n            frame_info.append({\n                \"track_id\": best_id,\n                \"feature_id\": feat[\"feature_id\"],     # frame-specific ID\n                \"centroid_rc\": feat[\"centroid_rc\"],   # row, col\n                \"mask\": mask,\n                \"overlap\": best_overlap,\n            })\n\n        tracked.append(frame_info)\n        prev = current\n\n    return tracked","key":"imgFVXXZfq"},{"type":"outputs","id":"Bgym1JGnxIwsfYOcHycNU","children":[],"key":"rYPuY5442m"}],"key":"c8wmOiemt6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tracked_mpl = track_slp_features_matplotlib(\n    da,\n    threshold=threshold,\n    min_area=20,\n    min_overlap=0.2,\n)","key":"IXRs01rp9w"},{"type":"outputs","id":"9k0xzG3kjs6CeZNBqOVh2","children":[],"key":"aX8LuUT9ig"}],"key":"W9F5Q5C16Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the animation of the SLP features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gxdCD9fgY8"}],"identifier":"lets-look-at-the-animation-of-the-slp-features","label":"Let’s look at the animation of the SLP features","html_id":"lets-look-at-the-animation-of-the-slp-features","implicit":true,"key":"crEkR2aI6g"}],"key":"xFZEKvOc5S"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"lat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\nlon2d, lat2d = np.meshgrid(lon, lat)\n\nlevels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # colored SLP contour lines\n    ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines and IDs\n    for feat in tracked_mpl[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"JfFUrZX8Q9"},{"type":"outputs","id":"2M9tWgYO6JXHAf3jLjjln","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":11,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"dc229c4099dd6e350784df5cd303c1ef","path":"/feature-tracking-cookbook/_preview/45/build/dc229c4099dd6e350784df5cd303c1ef.html"}}},"key":"JBtUZMR9Lq"}],"key":"CSDC0eyQdg"}],"key":"Jkc4MO9mBa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This animation shows the evolution of SLP through time using the overlap tracking method. The numeric annotations help follow the features. There seems to be a gap in tracking extratropical southern hemisphere which needs further inspection.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fvKImtAvE6"}],"key":"BBc1tTLqRx"}],"key":"MQc2qMYqpv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u2JvoWv3Fq"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"YjBthYbL57"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"In this recipe, we looked at how to identify low sea level pressure features in the northern hemisphere and tracking it through time along with associated precipitation.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iH8Cdtk0Pj"}],"key":"hihlgttwXp"},{"type":"heading","depth":3,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"typ