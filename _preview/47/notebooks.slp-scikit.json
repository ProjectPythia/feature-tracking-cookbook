eshold = 100000\nmin_area = 20\nmin_overlap = 0.2  ","key":"JnZd3eKQ3C"},{"type":"outputs","id":"Nm7r3QRt04J8AZoncBVsc","children":[],"key":"hUMfU16lv0"}],"key":"iCY8qDYJQ5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get the latitude and longitude 2d meshgrid for plotting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qk8eerYPv5"}],"identifier":"get-the-latitude-and-longitude-2d-meshgrid-for-plotting","label":"Get the latitude and longitude 2d meshgrid for plotting","html_id":"get-the-latitude-and-longitude-2d-meshgrid-for-plotting","implicit":true,"key":"aBBxnyL2XO"}],"key":"lLTNNWt58A"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"To plot SLP with contour(), we first create 2D latitude–longitude grids.\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qoFV0tBVT4"},{"type":"inlineCode","value":"SLP","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bE09VTEHLt"},{"type":"text","value":" : 1° × 1°","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cLfrUXVhr5"}],"key":"wIxTu9d95P"}],"key":"sOHEXHoxnC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- get lat/lon coords ----\n# assumes dims like (time, lat, lon)\nlat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)","key":"gdv4o1sFv5"},{"type":"outputs","id":"aGqIqEH2n7KDS6-BYxgCp","children":[],"key":"GfBHPjY0qr"}],"key":"zg7lkMq1ck"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select low SLP features less than a threshold using scikit","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hNBLWiW1Op"}],"identifier":"select-low-slp-features-less-than-a-threshold-using-scikit","label":"Select low SLP features less than a threshold using scikit","html_id":"select-low-slp-features-less-than-a-threshold-using-scikit","implicit":true,"key":"ZRW0DZcSky"}],"key":"S1mVH7ae3h"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ctDJJnKa6I"},{"type":"inlineCode","value":"detect_features()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"z9Qynl38yI"},{"type":"text","value":" function identifies low-pressure objects in a single SLP field. First, it creates a mask of all grid points where SLP is less than or equal to the chosen threshold. These grid points are treated as candidate low-pressure regions. The function then uses connected-component labeling to group neighboring grid points into separate features. Because ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UgGcOwkdcp"},{"type":"inlineCode","value":"connectivity=2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DEMhLlwua2"},{"type":"text","value":" is used, grid cells that touch along edges or corners are considered connected. After the initial labeling, very small features are removed using the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mn15sR1VBV"},{"type":"inlineCode","value":"min_area","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"c0FatCaP4u"},{"type":"text","value":" limit, so noisy or insignificant patches are not included. Finally, the remaining features are labeled again to produce a clean label map, where ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XXxciUlNHC"},{"type":"inlineCode","value":"0","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dCGAVAU6Hh"},{"type":"text","value":" represents the background and each positive integer represents a separate low-pressure feature.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gmAPyxKTKx"}],"key":"oiqrUe6NGm"}],"key":"OVTqUEZ0kH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(field, threshold=100000, min_area=20):\n    mask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"olp7HbsTQ7"},{"type":"outputs","id":"FBxuR_uRFg570bdul8gHj","children":[],"key":"i8jUaPe5mg"}],"key":"Y9A1YyEJt8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the labelled feature plotted for one time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ktuD9SPgEm"}],"identifier":"lets-look-at-the-labelled-feature-plotted-for-one-time-step","label":"Let’s look at the labelled feature plotted for one time step","html_id":"lets-look-at-the-labelled-feature-plotted-for-one-time-step","implicit":true,"key":"DkoPSUIEIf"}],"key":"pBvTmTeP4g"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s take a look at the labelled feature at time = 0 which at 2022 November 1 00:00 UTC along with precipitation overlay.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tAI6c5YYbu"}],"key":"U4HYlUwL8z"}],"key":"eE7V2ZalMp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = 0\nslp = da.isel(time=t).values","key":"zJkMmzcPF4"},{"type":"outputs","id":"Jjl2dGTz2gub_MQyuBL4j","children":[],"key":"Fx1bfqQG2n"}],"key":"T2CQP9G4VN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We call the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q06ceuA4eW"},{"type":"inlineCode","value":"detect_features()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ksWUFv9EYY"},{"type":"text","value":" function with the parameters set above","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gWVrSLA5RK"}],"key":"AoMsuBtetO"}],"key":"kxBGdkbyBF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"labels = detect_features(slp, threshold=threshold, min_area=min_area)","key":"TYDAZa9b7p"},{"type":"outputs","id":"8os8ID6NUKpwonzXivjSP","children":[],"key":"GmJ6rBkNIe"}],"key":"fi4Gd1Pj2U"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"levels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\n# colored SLP contour lines\nax.contour(\n    lon2d, lat2d, slp,\n    levels=levels,\n    cmap=\"turbo\",\n    linewidths=0.9,\n    transform=ccrs.PlateCarree()\n)\n\nax.contour(\n    lon2d,\n    lat2d,\n    labels.astype(int),\n    levels=[0.5],\n    colors=\"black\",\n    linewidths=1.6,\n    transform=ccrs.PlateCarree()\n)\n\nfor r in regionprops(labels):\n    y, x = r.centroid      # row, column\n    iy = int(round(y))\n    ix = int(round(x))\n\n\n    ax.plot(\n        lon[ix],\n        lat[iy],\n        \"ko\",\n        ms=3,\n        transform=ccrs.PlateCarree()\n    )\n\n    ax.text(\n        lon[ix],\n        lat[iy],\n        str(r.label),\n        fontsize=8,\n        color=\"black\",\n        ha=\"left\",\n        va=\"bottom\",\n        transform=ccrs.PlateCarree(),\n        bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n    )\n\n\nax.coastlines(color=\"0.55\", linewidth=0.6)\n\ngl = ax.gridlines(\n    draw_labels=True,\n    linewidth=0.4,\n    color=\"0.5\",\n    alpha=0.25,\n    linestyle=\"--\"\n)\ngl.top_labels = False\ngl.right_labels = False\n\nax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nplt.show()\n","key":"KQUb3q4BB4"},{"type":"outputs","id":"gcUNWOg309KcgFXTHzxY6","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/feature-tracking-dev/lib/python3.14/site-packages/cartopy/io/__init__.py:242: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/110m_physical/ne_110m_coastline.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"Hf8rXT2E3S"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"d51d1af9a72a846ba1620bf7ce4c2471","path":"/feature-tracking-cookbook/_preview/47/build/d51d1af9a72a846ba1620bf7ce4c2471.png"}}},"key":"Nams7G7NaF"}],"key":"HIQhxkOSy7"}],"key":"o7Gfb3hyz0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s track SLP Features Over Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ngPfUtRF3e"}],"identifier":"lets-track-slp-features-over-time","label":"Let’s track SLP Features Over Time","html_id":"lets-track-slp-features-over-time","implicit":true,"key":"R2V174BQyn"}],"key":"xUNpLDATwY"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We track the labelled SLP features from one time step to the next. Each detected feature is converted into a mask and compared with the masks from the previous time step. If a current feature overlaps strongly enough with a previous feature, it is treated as the same object and keeps the same track_id. If the overlap is too small, the feature is treated as a new object and is assigned a new track_id. For each time step, the code stores the feature ID, centroid location, and mask, which can later be used for plotting, animation, or further analysis of how the low-pressure systems move.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dFfJ94Ayq4"}],"key":"vOV8oiOV6M"}],"key":"jjYpMIyqDa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"I9nVmiX3J4"},{"type":"outputs","id":"5CJmw3tM0joQx-UyswDXp","children":[],"key":"NuL5eDczqJ"}],"key":"jXQqzk6hEw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the animation of the SLP features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z5irq3LPmd"}],"identifier":"lets-look-at-the-animation-of-the-slp-features","label":"Let’s look at the animation of the SLP features","html_id":"lets-look-at-the-animation-of-the-slp-features","implicit":true,"key":"JURnek5il4"}],"key":"NooBeQyKWg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"glcD37FG7V"},{"type":"outputs","id":"Jn9Tbb5TLrLExwAnzpSjR","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":10,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"ad289ecb95c8c866b291c2ce44d5f5b0","path":"/feature-tracking-cookbook/_preview/47/build/ad289ecb95c8c866b291c2ce44d5f5b0.html"}}},"key":"t76lQ8PFaF"}],"key":"K8HkMBk2pi"}],"key":"qMKnwfunIM"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This animation shows the evolution of SLP and precipitation through time using the overlap tracking method. The numeric annotations help follow individual systems across successive times, including cases where the detected object appears as nested within the larger low SLP features.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jWyqy6Bwqo"}],"key":"nUSuKJDomJ"}],"key":"bhcUrZDgJY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zX1aoMuER0"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"SN4gnhRpFA"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"In this recipe, we looked at how to identify low sea level pressure features in the northern hemisphere and tracking it through time along with associated precipitation.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mWJq0zdHOo"}],"key":"E4lvmjuB0M"},{"type":"heading","depth":3,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"What’s next?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"wWO8BvkSeG"}],"identifier":"whats-next","label":"What’s next?","html_id":"whats-next","implicit":true,"key":"JeMMY297Sm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"We will do more noise reduction and smoothing and associated area and region properties.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ctGYE4GAB6"}],"key":"fyyBbgxPPO"}],"key":"PVgNz0rsWF"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Explore the tracking algorithm with cloud dataset or  ERA5 datasets provided by Copernicus.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"HUQUhMbMSx"}],"key":"pFkWfYv44K"}],"key":"l4kWNl0m5c"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Similar Tracking with SST or CWV thresholds.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"OFX07MqX9D"}],"key":"qA9HUiiep8"}],"key":"WlGZwNy6Fq"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The current workflow does not include smoothing, noise reduction, or explicit split/merge flagging.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"pn6Bp700lY"}],"key":"eeWYILd98l"}],"key":"VoV76T1SAj"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Specific Regions of interest.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"J2DNMYk48e"}],"key":"gKcCUfXGmJ"}],"key":"hMq4klMlnt"}],"key":"PWMdFnmgSg"}],"key":"LNlyC5GyUN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resources and references","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vTrDtCLQy6"}],"identifier":"resources-and-references","label":"Resources and references","html_id"