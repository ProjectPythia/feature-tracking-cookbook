},"end":{"line":7,"column":1}},"key":"k76TKlWDxx"}],"key":"ydiixiMLn7"}],"key":"nchHef9WrS"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Very small regions (below ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"prnKDJjFLR"},{"type":"inlineCode","value":"min_area","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"zTipSlkSEj"},{"type":"text","value":") are removed.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"MCqIrwzkDD"}],"key":"g3BgQ2N8ky"}],"key":"Uj5iCuQoeS"}],"key":"QjBfZFVNGg"}],"key":"JHp6jB3hmj"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each detected feature, compare it with features from the previous time step.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"v80x3C6Hmt"}],"key":"YpQIAvCXPv"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Compute spatial overlap between the current feature mask and previous feature masks. If the new feature overlaps enough (exceeds ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"OzWkYqVdGC"},{"type":"inlineCode","value":"min_overlap","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"TSDWbyeoLM"},{"type":"text","value":") with an old feature, it keeps the same ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"FlDlHO175v"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"AAPCXtHQTD"},{"type":"text","value":". Otherwise, it is treated as a new feature and receives a new track_id.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"vQ9ADLkmzd"}],"key":"amWF5bhs8O"}],"key":"fLiSsWFLBH"}],"key":"cawFuPcfAM"}],"key":"G8z6FhZS0n"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Store the feature’s ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"uMt538gwn9"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"RF9Hqiy9oE"},{"type":"text","value":", centroid location, and mask for plotting or later analysis.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"EoU3oNoxNl"}],"key":"HvIF6BUzjN"}],"key":"PPO4TBYo1L"}],"key":"xtsgxN6M03"}],"visibility":"show","key":"hcBhLUdVHp"},{"type":"block","kind":"notebook-code","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(\n    field,\n    threshold=threshold,\n    min_area=min_area,\n    min_overlap=min_overlap\n):\n    \"\"\"\n    Track regions with low total precipitation (total precipitation <= threshold) using Matplotlib contours.\n    \"\"\"\n    ny, nx = data.isel(time=0).shape\n    yy, xx = np.mgrid[0:ny, 0:nx]\n    points = np.column_stack([xx.ravel(), yy.ravel()])\n\n    tracked = []\n    prev = {}\n    next_track_id = 1\n\n    for t in range(data.sizes[\"time\"]):\n        field = data.isel(time=t).values\n        fig, ax = plt.subplots()\n        cs = ax.contour(field, levels=[threshold])\n        plt.close(fig)\n\n        current = {}\n        frame_info = []\n\n        for seg in cs.allsegs[0]:\n            path = Path(seg)\n            mask = path.contains_points(points).reshape(ny, nx)\n\n            # keep low precipitation regions only\n            mask = mask & (field <= threshold)\n            if mask.sum() < min_area:\n                continue\n\n            y, x = np.where(mask)\n            centroid = (y.mean(), x.mean())\n\n            best_id = None\n            best_overlap = 0\n\n            for track_id, old_mask in prev.items():\n                overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n\n                if overlap > best_overlap:\n                    best_overlap = overlap\n                    best_id = track_id\n\n            if best_overlap < min_overlap:\n                best_id = next_track_id\n                next_track_id += 1 \n\n            current[best_id] = mask\n\n            frame_info.append({\n                \"track_id\": best_id,\n                \"mask\": mask,\n                \"centroid_rc\": centroid,\n            })\n\n        tracked.append(frame_info)\n        prev = current\n\n    return tracked","visibility":"show","key":"N8olYxWrEb"},{"type":"outputs","id":"_xK_MtlpSt1BHiyUip836","children":[],"visibility":"show","key":"YFZTcDVARf"}],"visibility":"show","key":"wCN6cfD1aj"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Note that our function identifies these features for a ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D3Ud6sPXR7"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"single time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yh8euye1CM"}],"key":"dzjN8moIK0"},{"type":"text","value":". So to track these regions ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qE453WBmgT"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"over time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"f1Z0cM6Rhc"}],"key":"ettiz7DwqG"},{"type":"text","value":", we must iterate through all time steps present in our data, and call ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NKoB6Pzm6V"},{"type":"inlineCode","value":"detect_features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sa78Vucnrl"},{"type":"text","value":" on each interval.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WVOjN9cNmd"}],"key":"rSi5T8XIGd"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Run the tracking function for each time step, and save the results in a variable ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oRVHBJEPgg"},{"type":"inlineCode","value":"tracked","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PnkwZE0BfA"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vRvahxinrr"}],"key":"TZHpuug3AN"}],"visibility":"show","key":"wfUqb3Aip4"},{"type":"block","kind":"notebook-code","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"tracked = detect_features(\n    data,\n    threshold=threshold,\n    min_area=min_area,\n    min_overlap=min_overlap,\n)","visibility":"show","key":"d5YPMDRUPw"},{"type":"outputs","id":"hYmrowX5Ys6XgNarWPeTN","children":[],"visibility":"show","key":"Yy8JllIFoY"}],"visibility":"show","key":"SiLAFqiLBJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"In the visualization, we will have a colorbar that represent precipitation levels. We want the bar to accurately depict the bulk of the data, so we limit the lower end to the 1st percentile of the data, and the upper end to the 99th percentile.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dNVLZuHbon"}],"key":"HwxaXWq6AD"}],"key":"TA6jIg8Y5d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Find 1st percentile and 99th percentile of total precipitation values\nvals = data.values\nvmin = np.nanpercentile(vals, 1)\nvmax = np.nanpercentile(vals, 99)\n\nlevels = np.linspace(vmin, vmax, 16) # evenly spaced intervals\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax) # normalize\ncmap = 'turbo' # colormap","key":"dPhhTt17k4"},{"type":"outputs","id":"IhoCr85-gOsL2D-p0M099","children":[],"key":"gfUUAon1rJ"}],"key":"oJhp2PodQK"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We can animate the storm tracked over time by plotting the low precipitation regions at each timestep.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KY6EOCJzQV"}],"key":"lnl7TAcSOH"}],"key":"yWpFZwUy9i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def update(t):\n    \"\"\"\n    Animation function, goes through each timestep and its tracked precipitation.\n    \"\"\"\n    ax.clear()\n    ax.set_extent(extent, crs=ccrs.PlateCarree())\n    ax.set_aspect('auto')\n    title = fig.suptitle(\"\")\n\n    field = data.isel(time=t).values # total precipitation data for current timestep\n\n    # Colored contour lines\n    ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=cmap,\n        norm=norm,\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # Tracked feature outlines\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # Create outlines for continents/coastlines and gridlines\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    \n    gl.top_labels = False\n    gl.right_labels = False\n    title.set_text(\n        f\"Extratropical cyclone precipitation features at hour {t}\"\n    )","key":"zGIfnzgSXw"},{"type":"outputs","id":"Z6m4MiwuoFlMBy5NRIQSS","children":[],"key":"mYjRGeQhez"}],"key":"CISYgWyAZF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create map\nfig, ax = plt.subplots(figsize=(12, 5), subplot_kw={\"projection\": ccrs.PlateCarree()})\nextent = [lon.min(), lon.max(), lat.min(), lat.max()] # geographic boundaries of the map\nax.set_extent(extent, crs=ccrs.PlateCarree())\n\n# Create colorbar\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(\n    sm,\n    ax=ax,\n    orientation=\"horizontal\",\n    pad=0.15\n)\ncbar.set_label(\"Total Precipitation (mm LWE h$^{-1}$)\")\n\n# Create animation\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=data.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"TCaxzIYGIg"},{"type":"outputs","id":"WZLfUcK3SPVAYi1rc59i3","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":10,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"6b1f3593ce5672e6bf89ed5c21708121","path":"/feature-tracking-cookbook/build/6b1f3593ce5672e6bf89ed5c21708121.html"}}},"key":"yFChaxYz5h"}],"key":"turSnv9R21"}],"key":"E2Xp5Cf1mF"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This animation showcases the total precipitation values of low precipitation systems from hours 0 to 12. These feature systems appear between the latitudes 30°N and 70°N (hence the boundaries of the map) which is typical for an extratropical cyclone.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jSBGO7ZIHf"}],"key":"LBMeV0Cz7Z"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Through tracking, we see that most of the systems head towards the East as the hour increases. We also are able to track whether these precipitation areas break apart, which is typical behavior during an extratropical cyclone. For example, see the leftmost precipitation system on the map. It heads toward the East direction and splits at hour 7.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z9KmEJnEJh"}],"key":"xFixH3gav6"}],"visibility":"show","key":"xu3R8OtV9y"}],"key":"eD8vMlFyv6"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Foundations","url":"/notebooks/foundations","group":"Foundations"},"next":{"title":"Scipy","url":"/notebooks/precip-scipy","group":"Precipitation Tracking"}}},"domain":"http://localhost:3000"}