 values at time = 0\nhr_0_data = data.sel(time=data.time[0])\n\n# Look at the range of total precipitation\nplt.hist(hr_0_data.values.ravel(), bins=50)\nplt.xlabel(\"Total Precipitation (mm LWE h$^{-1}$)\")\nplt.ylabel(\"Number of Grid Cells\")\nplt.title(\"Distribution of Precipitation at Hour 0\")\nplt.show()","key":"t3PFDzKhF1"},{"type":"outputs","id":"zmbFLVCZD3APenhM52zBq","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"8b1cd46d0d217e35a9f5d565f3b21453","path":"/feature-tracking-cookbook/build/8b1cd46d0d217e35a9f5d565f3b21453.png"}}},"key":"A7Sx4GOTm2"}],"key":"SOhOH4vDpL"}],"key":"WMSJgBsbmB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The majority of precipitation values are between 0 and 2 mm. Let’s use that as a filter so we can visualize the data in a way that corresponds to the bulk of the data, rather than a few askew values.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uqVfQgLS2g"}],"key":"qsQMc7t2pv"}],"key":"ULllQ997YU"},{"type":"block","kind":"notebook-code","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Plot precipitation at hour 0\nfig, ax = plt.subplots(\n    figsize=(12, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\nim = ax.pcolormesh(\n    hr_0_data.longitude,\n    hr_0_data.latitude,\n    hr_0_data.values,\n    transform=ccrs.PlateCarree(),\n    cmap=\"turbo\",\n    vmin=0,\n    vmax=2\n)\n\n# Add gridlines\nax.add_feature(cfeature.COASTLINE)\ngl = ax.gridlines(draw_labels=True)\ngl.top_labels = False\ngl.right_labels = False\n\n# Add colorbar and labels\nfig.colorbar(im, ax=ax, orientation=\"horizontal\", pad=0.1,\n             label='Total Precipitation (mm LWE h$^{-1}$)')\nax.set_title(\"Total precipitation at hour 0\")\nplt.show()","visibility":"show","key":"SpsWfNP3nt"},{"type":"outputs","id":"AEbYrdrRSdcrGxQTdMtEX","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stderr","text":"/home/runner/micromamba/envs/feature-tracking-dev/lib/python3.14/site-packages/cartopy/io/__init__.py:263: DownloadWarning: Downloading: https://naturalearth.s3.amazonaws.com/110m_physical/ne_110m_coastline.zip\n  warnings.warn(f'Downloading: {url}', DownloadWarning)\n"},"key":"ryqMOCu2Yh"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1200x400 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"afb40569d1fec9d0ddea13ec0e4d4a40","path":"/feature-tracking-cookbook/build/afb40569d1fec9d0ddea13ec0e4d4a40.png"}}},"key":"spag0JZHq5"}],"visibility":"show","key":"fSIJUbbm3c"}],"visibility":"show","key":"gkqiAR0U22"},{"type":"block","kind":"notebook-content","data":{"editable":true,"slideshow":{"slide_type":""},"tags":[]},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Track Features Over Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lm4JnFJcJP"}],"identifier":"track-features-over-time","label":"Track Features Over Time","html_id":"track-features-over-time","implicit":true,"key":"IUppjPbozw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We will find the contours later using ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Glvpx8SVnR"},{"type":"inlineCode","value":"matplotlib.pyplot.contour","position":{"start":{"line":3,"column":1},"end":{"line":3,"colum