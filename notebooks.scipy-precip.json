},"key":"mCNk1GTLG8"}],"key":"ToYxSuOint"}],"key":"gvZkjLqQIw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Understanding the Algorithm: Plotting One Specific Feature Through Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iP2gnKCJgK"}],"identifier":"understanding-the-algorithm-plotting-one-specific-feature-through-time","label":"Understanding the Algorithm: Plotting One Specific Feature Through Time","html_id":"understanding-the-algorithm-plotting-one-specific-feature-through-time","implicit":true,"key":"Tf3c7CAyi9"}],"key":"ZzVj297Ixq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s pull out the subset of the data that is specific to a partiuclar time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D1tgrddQaM"}],"key":"qRryjsOEvp"}],"key":"jlOZUVDUfH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def precip_time_index(full_data, time_index):\n    time = full_data.time[time_index]\n    subset_data = full_data.sel(time=time)\n\n    return subset_data","key":"dcaUVqLaSJ"},{"type":"outputs","id":"qB9tq0FtOFOCryuynUVwb","children":[],"key":"C0hQ6r97AI"}],"key":"f75x9CAQXd"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s create a function that will perform the algorithm.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yIcvq7EV6p"}],"key":"T1awFB1oAV"}],"key":"N9t1LPjwFZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def precip_feature(data, time_index):\n    subset_data = precip_time_index(data, time_index)\n\n    no_minimal_precip = subset_data['ETC_tp'].where(subset_data['ETC_tp'] > 0.25, 0)\n    s = generate_binary_structure(2,2)\n\n    labeled_data, num_data = label(no_minimal_precip, structure=s)\n\n    return labeled_data","key":"hFEXqS0YCk"},{"type":"outputs","id":"IOp3OP3r7CeRqM9g22CrK","children":[],"key":"BqKGy3VQZq"}],"key":"Th0C3MXwlu"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"If we only want to identify one precipitation feature, let’s choose the feature that is associated with id == 1. We’ll create a function to create this subsetted data.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"srh0BtxSgM"}],"key":"UF8KKZM7GA"}],"key":"z8Kno7cuCJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def subset_precip_feature(full_data):\n    return np.where(full_data, full_data==1, 0)","key":"e2ndnFO3kb"},{"type":"outputs","id":"8dwbGuKden8g8W7ZnB9dK","children":[],"key":"nIjGGl45XB"}],"key":"wnUq63hqml"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s go ahead and plot this one specific feature throughout the full 12 hours of the event.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Zs8uNK1InG"}],"key":"ghuY4XUGP7"}],"key":"mpgWK8qRYD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i in range(13):\n    plt.figure(figsize=(15,8))\n    ax = plt.axes(projection=ccrs.PlateCarree())\n    lon2d, lat2d = np.meshgrid(no_minimal_precip['longitude'], no_minimal_precip['latitude'])\n    subset_labeled_data = subset_precip_feature(precip_feature(data, i))\n    plt.contour(lon2d, lat2d, subset_labeled_data, shading='nearest', cmap='tab20b', transform=ccrs.PlateCarree())\n    precip_data = precip_time_index(data, i)['ETC_tp'].to_numpy()\n    precip_data[precip_data <= 0] = np.nan\n    im = plt.pcolormesh(lon2d, lat2d, precip_data, cmap='BrBG', transform=ccrs.PlateCarree(), vmin=0, vmax=1)\n\n    plt.colorbar(im, label='Precipitation Rate [mm/hr]', shrink=0.4)\n\n    ax.set_extent([60, 150, 70, 80])\n\n    ax.add_feature(cfeature.LAND)\n    ax.add_feature(cfeature.BORDERS, edgecolor='black')\n    ax.add_feature(cfeature.STATES, edgecolor='black')\n    \n    ax.add_feature(cfeature.COASTLINE, edgecolor='black')\n\n    plt.title('Precip Feature 1 at Time Index ' + str(i))\n    \n    provinces = cfeature.NaturalEarthFeature(\n        category='cultural',\n        name='admin_1_states_provinces_lines',\n        scale='50m',\n        facecolor='none',\n        edgecolor='black'\n    )\n    ax.add_feature(provinces)\n    ax.gridlines(draw_labels=True)","key":"ZeYc4xagEH"},{"type":"outputs","id":"cb1HLyGFW2mS6KwAT-3px","children":[],"key":"weG6eEA61W"}],"key":"DkK3yTcw6w"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"These plots show the identification of a single precipitation feature throughout time (contoured). The filled contours are the hourly precipitation rate. The dark brown areas throughout each map represent the area where no precipitation was recorded. Therefore, each area that isn’t dark brown area represents a location that received some precipitation.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cGIvkooZs8"}],"key":"jijAM8k6IH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"At time index 0, we can see that feature one corresponds to a large area of precipitation between 95°E to 115°E, as made out by the purple contour. As this area is continuously above 0.25mm/hr, the entire area is assigned to a single feature. With increasing time, the feature can be seen moving eastward, eventually reaching 125°E at time index 6.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BVTszRh4Am"}],"key":"ZhPmAv6Jmn"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"However, at time index 7, the contour no longer corresponds to the area of precipitation centered over 120°E. Instead, the feature is centered around 100°E. Between time index 6 and 7, these two precipitation areas break apart. In between these two precipitation features, there is now an area that has a precipitation rate of less than 0.25mm/hr, the critical rate we set for determining whether it is “precipitating” or not. Since these two features can no longer be connected, they are now treated as seperate features. Therefore, the purple contour is located only over the precipitation feature at 100°E and not 120°E.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Uyws5p3Lax"}],"key":"STbfitJd0L"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Between time indicies 7-9, we can observe the precipitation feature continuously shrinks, eventually reaching zero precipitation at time index 10. Since there is no precipitation features within this area, the index assigned to feature 1 is now shifted to a different location, and is no longer associated with the feature over northern Siberia.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"RBSKDS1XIq"}],"key":"Va3rLqCjfr"}],"key":"kKorChOGtr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s create an animation of the evolution of this single precipitation feature throughout time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XEFKA07b5m"}],"identifier":"lets-create-an-animation-of-the-evolution-of-this-single-precipitation-feature-throughout-time","label":"Let’s create an animation of the evolution of this single precipitation feature throughout time.","html_id":"lets-create-an-animation-of-the-evolution-of-this-single-precipitation-feature-throughout-time","implicit":true,"key":"LP1ANCzV3W"}],"key":"i3ScOCJHt6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## Let's create a function to write the figures necessary for the animation.\n\n## Creating a colorbar across all frames.\nvmin = 0\nvmax = 1\nlevels = np.linspace(vmin, vmax, 10)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap='BrBG'\n\nfig, ax = plt.subplots(subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"Precipitation Rate [mm/hr]\")\n\ndef func(i):\n    ax.clear()\n    lon2d, lat2d = np.meshgrid(no_minimal_precip['longitude'], no_minimal_precip['latitude'])\n    subset_labeled_data = subset_precip_feature(precip_feature(data, i))\n    plt.contour(lon2d, lat2d, subset_labeled_data, shading='nearest', cmap='tab20b', transform=ccrs.PlateCarree())\n    precip_data = precip_time_index(data, i)['ETC_tp'].to_numpy()\n    precip_data[precip_data <= 0] = np.nan\n    im = plt.pcolormesh(lon2d, lat2d, precip_data, cmap='BrBG', transform=ccrs.PlateCarree(), vmin=0, vmax=1)\n\n    ax.set_extent([60, 150, 70, 80])\n\n    ax.add_feature(cfeature.LAND)\n    ax.add_feature(cfeature.BORDERS, edgecolor='black')\n    ax.add_feature(cfeature.STATES, edgecolor='black')\n    \n    ax.add_feature(cfeature.COASTLINE, edgecolor='black')\n\n    ax.set_title('Precip Feature 1 at Time Index ' + str(i))\n    \n    provinces = cfeature.NaturalEarthFeature(\n        category='cultural',\n        name='admin_1_states_provinces_lines',\n        scale='50m',\n        facecolor='none',\n        edgecolor='black'\n    )\n    ax.add_feature(provinces)\n    ax.gridlines(draw_labels=True)\n    return fig,\n\n\nanim = FuncAnimation(fig, func, frames=12, interval=300, blit=False)\nHTML(anim.to_jshtml())","key":"ptX99Fk1Em"},{"type":"outputs","id":"WebP91_yU66F1RrKEifNc","children":[],"key":"z5jvwJHaz7"}],"key":"rx7nJGwwNN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s apply this method to worldwide cases.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QpgocsKEWO"}],"identifier":"now-lets-apply-this-method-to-worldwide-cases","label":"Now let’s apply this method to worldwide cases.","html_id":"now-lets-apply-this-method-to-worldwide-cases","implicit":true,"key":"y7ONypztdO"}],"key":"rV5BZNVmah"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i in range(13):\n    plt.figure(figsize=(15,8))\n    ax = plt.axes(projection=ccrs.PlateCarree())\n    lon2d, lat2d = np.meshgrid(no_minimal_precip['longitude'], no_minimal_precip['latitude'])\n    labeled_data = precip_feature(data, i)\n    plt.contour(lon2d, lat2d, labeled_data, shading='nearest', cmap='tab20b', transform=ccrs.PlateCarree())\n    precip_data = precip_time_index(data, i)['ETC_tp'].to_numpy()\n    precip_data[precip_data <= 0] = np.nan\n    im = plt.pcolormesh(lon2d, lat2d, precip_data, cmap='BrBG', transform=ccrs.PlateCarree(), vmin=0, vmax=1)\n\n    plt.colorbar(im, label='Precipitation Rate [mm/hr]', shrink=0.4)\n\n    ax.add_feature(cfeature.LAND)\n    ax.add_feature(cfeature.BORDERS, edgecolor='black')\n    ax.add_feature(cfeature.STATES, edgecolor='black')\n    \n    ax.add_feature(cfeature.COASTLINE, edgecolor='black')\n\n    plt.title('Precip Features at Time Index ' + str(i))\n    \n    provinces = cfeature.NaturalEarthFeature(\n        category='cultural',\n        name='admin_1_states_provinces_lines',\n        scale='50m',\n        facecolor='none',\n        edgecolor='black'\n    )\n    ax.add_feature(provinces)\n    ax.gridlines(draw_labels=True)","key":"x2mIrYnFzt"},{"type":"outputs","id":"CybJ0_fKU4qjdox_Jelbq","children":[],"key":"wrBxFjpHKU"}],"key":"rJ4s1hKJpj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Ok, so we can’t really see much from this diagram, since there’s a lot of countering going on... Instead of contouring based upon label number, let’s contour based upon the maximum precipitation rate found within the countered region.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q87TIt5Ehv"}],"key":"J4tbiA6QYX"}],"key":"OIQ4QErnSS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Working with Maximum Precipitation Rate Found within Countered Region","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jIrKjOaACm"}],"identifier":"working-with-maximum-precipitation-rate-found-within-countered-region","label":"Working with Maximum Precipitation Rate Found within Countered Region","html_id":"working-with-maximum-precipitation-rate-found-within-countered-region","implicit":true,"key":"NUctgF1OEI"}],"key":"SWQpeZ9kkS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create an empty array to hold the maximum prec