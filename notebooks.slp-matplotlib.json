r plotting","html_id":"get-the-latitude-and-longitude-2d-meshgrid-for-plotting","implicit":true,"key":"pdeQGH21dc"}],"key":"APVtbKO1Jo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"To plot SLP with contour(), we first create 2D latitude–longitude grids. The ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jFWjW8nF9u"},{"type":"inlineCode","value":"SLP","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cKYSKduWRS"},{"type":"text","value":" dataset is at a resolution of 1° × 1°.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C9xWTeOowC"}],"key":"uM0suZDvxX"}],"key":"JFjTkGS7VB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"lat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)","key":"irpSWrgD6h"},{"type":"outputs","id":"t1uLIQ8tQxroWb-WK7XBU","children":[],"key":"yMY2jKtKNs"}],"key":"AODeM7zNWe"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select low SLP features less than a threshold using matplotlib contour()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OYZcukImOp"}],"identifier":"select-low-slp-features-less-than-a-threshold-using-matplotlib-contour","label":"Select low SLP features less than a threshold using matplotlib contour()","html_id":"select-low-slp-features-less-than-a-threshold-using-matplotlib-contour","implicit":true,"key":"laLFuVkfa5"}],"key":"CfK3iGldBh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This function detects low-pressure SLP features from a single time step using Matplotlib contours. First, it draws the contour line at the chosen SLP threshold, such as 1000 or 1005 hPa. Each closed contour segment is then converted into a filled polygon mask, which marks the grid cells inside that contour. Since we only want low-pressure systems, the mask is further restricted to grid points where SLP <= ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A8ro8sGdes"},{"type":"inlineCode","value":"threshold","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jJrIbcQINL"},{"type":"text","value":". Very small objects are removed using the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yQzhe4OP5l"},{"type":"inlineCode","value":"min_area","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N38LYIHo0O"},{"type":"text","value":" limit. For each remaining feature, the function stores a frame-specific feature_id, the feature mask, and its centroid location as row and column indices.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wHd8c1bAPz"}],"key":"x7dV0zFNPY"}],"key":"CWtpfDVa3E"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features_matplotlib(field, threshold=100000, min_area=20):\n    ny, nx = field.shape\n\n    yy, xx = np.mgrid[0:ny, 0:nx]\n    points = np.column_stack([xx.ravel(), yy.ravel()])\n\n    # Draw contour at the SLP threshold\n    fig, ax = plt.subplots()\n    cs = ax.contour(field, levels=[threshold])\n    plt.close(fig)\n\n    features = []\n    feature_id = 1\n\n    for seg in cs.allsegs[0]:\n\n        if len(seg) < 3:\n            continue\n\n        path = Path(seg)\n\n        # Convert contour polygon into a filled mask\n        mask = path.contains_points(points).reshape(ny, nx)\n\n        # Keep only the low-pressure side of the contour\n        mask = mask & (field <= threshold)\n\n        # Remove tiny features\n        if mask.sum() < min_area:\n            continue\n\n        # Centroid from mask grid cells\n        y, x = np.where(mask)\n        centroid = (y.mean(), x.mean())   # row, col\n\n        features.append({\n            \"feature_id\": feature_id,\n            \"mask\": mask,\n            \"centroid_rc\": centroid,\n        })\n\n        feature_id += 1\n\n    return features","key":"t4aYUuyvw2"},{"type":"outputs","id":"Xlb2_eRxWRlESVsguX_Em","children":[],"key":"AtTwXDdY60"}],"key":"T81TZOesq3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test it out for the first time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jzPJNSz7GW"}],"identifier":"test-it-out-for-the-first-time-step","label":"Test it out for the first time step","html_id":"test-it-out-for-the-first-time-step","implicit":true,"key":"YofvWvSwnA"}],"key":"J5ITJSxjRP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s take a look at the labelled feature at time = 0 which at 2022 November 1 00:00 UTC.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ie2rwsWfja"}],"key":"v7VBtWRLgM"}],"key":"tM95vyviqf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = 0\nslp = da.isel(time=t).values","key":"AXVYBrB0V1"},{"type":"outputs","id":"qjKLKHAyO5-V3udzJ6Jck","children":[],"key":"iwMj0GeHhU"}],"key":"cfYmIz62Yf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We call the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"En7nbExqxF"},{"type":"inlineCode","value":"detect_features_matplotlib()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lRoCW7oxyl"},{"type":"text","value":" function with the parameters set above","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Hts0xwgSXn"}],"key":"I8YE4qcVtA"}],"key":"gbRWBsWmDa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"labels = detect_features_matplotlib(slp, threshold=threshold, min_area=min_area)","key":"QXvNosUh1x"},{"type":"outputs","id":"8x1kQARX7ntOt68zI7Kvm","children":[],"key":"NQiNQ83aOg"}],"key":"FnYA6JB5HA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"levels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\n# colored SLP contour lines\nax.contour(\n    lon2d, lat2d, slp,\n    levels=levels,\n    cmap=\"turbo\",\n    linewidths=0.9,\n    transform=ccrs.PlateCarree()\n)\n\n\nfor feat in labels:\n\n    mask = feat[\"mask\"]\n\n    ax.contour(\n        lon2d,\n        lat2d,\n        mask.astype(int),\n        levels=[0.5],\n        colors=\"black\",\n        linewidths=1.6,\n        transform=ccrs.PlateCarree()\n    )\n\n    y, x = feat[\"centroid_rc\"]   # row, column\n    iy = int(round(y))\n    ix = int(round(x))\n\n    ax.plot(\n        lon[ix],\n        lat[iy],\n        \"ko\",\n        ms=3,\n        transform=ccrs.PlateCarree()\n    )\n\n    ax.text(\n        lon[ix],\n        lat[iy],\n        str(feat[\"feature_id\"]),\n        fontsize=8,\n        color=\"black\",\n        ha=\"left\",\n        va=\"bottom\",\n        transform=ccrs.PlateCarree(),\n        bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n    )\n\n\nax.coastlines(color=\"0.55\", linewidth=0.6)\n\ngl = ax.gridlines(\n    draw_labels=True,\n    linewidth=0.4,\n    color=\"0.5\",\n    alpha=0.25,\n    linestyle=\"--\"\n)\ngl.top_labels = False\ngl.right_labels = False\n\n#ax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nplt.show()\n","key":"nPR5LYmG6S"},{"type":"outputs","id":"Lx4kLoW4H1yMcHGtDaw1K","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"6a784f25e175f5268def6ca3a3de0c57","path":"/feature-tracking-cookbook/build/6a784f25e175f5268def6ca3a3de0c57.png"}}},"key":"Sis26i2Djl"}],"key":"p25KPrq7ih"}],"key":"mHTfhr7dUd"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"imHDU5W3ZX"}],"key":"aAteBowH9J"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This method presents a visual seam near 0/360 longitude","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ZMC97BOSC1"}],"key":"GA6R82vIj0"}],"key":"V3B36c31gN"}],"key":"J54KqCM2kw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s track SLP Features Over Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UsfIaiuQf0"}],"identifier":"lets-track-slp-features-over-time","label":"Let’s track SLP Features Over Time","html_id":"lets-track-slp-features-over-time","implicit":true,"key":"DCrgVUqMIE"}],"key":"PcsuhoPvYm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This function tracks the Matplotlib-detected SLP features through time. It starts with an empty list to store the tracked features, an empty dictionary to store features from the previous time step, and a counter for assigning new ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hzczl0iHU9"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X0oS9GCnoy"},{"type":"text","value":" values. For each time step, the function first detects the low-pressure features using ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BTjoGkDBT2"},{"type":"inlineCode","value":"detect_features_matplotlib()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BUYnP3tHer"},{"type":"text","value":". It then compares each current feature mask with the masks from the previous time step. The overlap is calculated as the fraction of the current feature that overlaps with an older feature. If the overlap is larger than the chosen min_overlap threshold, the current feature keeps the same ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iIIF3PT23N"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a1WbLSlYbZ"},{"type":"text","value":". If there is not enough overlap, the feature is treated as a new object and receives a new ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yzWluXRYOa"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W0HWYWF25r"},{"type":"text","value":". For each frame, the function stores the persistent ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oElUbwoTW0"},{"type":"inlineCode","value":"track_id","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oexLatW1K9"},{"type":"text","value":", the frame-specific feature_id, the centroid location, the mask, and the overlap value. The final output is a time-ordered list of tracked SLP features that can be used for plotting or animation.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"T2cF8mv56L"}],"key":"Scr2lkQkes"}],"key":"QKr9qKUcV9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def track_slp_features_matplotlib(\n    da,\n    threshold=100000,\n    min_area=20,\n    min_overlap=0.2,\n):\n    \"\"\"\n    Track SLP low-pressure features detected using Matplotlib contours.\n\n    Tracking rule:\n        A feature keeps the same track_id if it overlaps enough\n        with a feature from the previous time step.\n    \"\"\"\n\n    tracked = []\n    prev = {}\n    next_track_id = 1\n\n    for t in range(da.sizes[\"time\"]):\n\n        field = da.isel(time=t).values\n\n        # Detect features at this time step\n        features = detect_features_matplotlib(\n            field,\n            threshold=threshold,\n            min_area=min_area\n        )\n\n        current = {}\n        frame_info = []\n\n        for feat in features:\n\n            mask = feat[\"mask\"]\n\n            best_id = None\n            best_overlap = 0.0\n\n            for track_id, old_mask in prev.items():\n\n                overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n\n                if overlap > best_overlap:\n                    best_overlap = overlap\n                    best_id = track_id\n\n            # Assign new ID if no strong overlap with previous features\n            if best_overlap < min_overlap:\n                best_id = next_track_id\n                next_track_id += 1\n\n            current[best_id] = mask\n\n            frame_info.append({\n                \"track_id\": best_id,\n                \"feature_id\": feat[\"feature_id\"],     # frame-specific ID\n                \"centroid_rc\": feat[\"centroid_rc\"],   # row, col\n                \"mask\": mask,\n                \"overlap\": best_overlap,\n            })\n\n        tracked.append(frame_info)\n        prev = current\n\n    return tracked","key":"AnG31AcJ2I"},{"type":"outputs","id":"njwQoyT0MZv1Mzmn2554Y","children":[],"key":"Jicrxtg9s9"}],"key":"g6nq6S60DZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tracked_mpl = track_slp_features_matplotlib(\n    da,\n    threshold=threshold,\n    min_area=20,\n    min_overlap=0.2,\n)","key":"juTXeKyyhG"},{"type":"outputs","id":"DBnvRYGMwh4VNxKWyWp4H","children":[],"key":"r1OOGla2Sl"}],"key":"Qe7iN8kNys"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the animation of the SLP features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"htvfJcubSO"}],"identifier":"lets-look-at-the-animation-of-the-slp-features","label":"Let’s look at the animation of the SLP features","html_id":"lets-look-at-the-animation-of-the-slp-features","implicit":true,"key":"WZnVXUWYUg"}],"key":"jBSghEcXuC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"lat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\nlon2d, lat2d = np.meshgrid(lon, lat)\n\nlevels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # colored SLP contour lines\n    ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines and IDs\n    for feat in tracked_mpl[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    #ax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"JBxKyQGhK5"},{"type":"outputs","id":"OyO08IBvi3ncFWpcPUSF8","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":11,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"31e3e8792b138d823e0a2148c64b2064","path":"/feature-tracking-cookbook/build/31e3e8792b138d823e0a2148c64b2064.html"}}},"key":"SIoSmb4t48"}],"key":"gk1uxqsYgB"}],"key":"io6TVhewI0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This animation shows the evolution of SLP through time using the overlap tracking method. The numeric annotations help follow the features. There seems to be a gap in tracking extratropical southern hemisphere which needs further inspection.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NYdemnkjIV"}],"key":"PGckGU5syr"}],"key":"GTyLg8D2fi"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"SYJP69GEzQ"}],"key":"goSN0aeC71"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The results may be sensitive to the chosen SLP threshold.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RchTKfI4mx"}],"key":"HkTBdeo50F"}],"key":"WtptFHvWgF"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The workflow does not yet include smoothing or noise reduction.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"A04ITSj7rI"}],"key":"NpLIigDnyy"}],"key":"TdB081GvW4"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Splits and merges between features are not explicitly flagged.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XLqjLIMPfh"}],"key":"qExB4ElLlR"}],"key":"iZVSssbppX"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"childr