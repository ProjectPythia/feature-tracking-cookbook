ask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"eUOpo7xleh"},{"type":"outputs","id":"CHfJj5_mbnJkBs1BXwRx9","children":[],"key":"wnfNbPgVKg"}],"key":"HjtEb680H6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the labelled feature plotted for one time step","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GuKHIUjp7Q"}],"identifier":"lets-look-at-the-labelled-feature-plotted-for-one-time-step","label":"Let’s look at the labelled feature plotted for one time step","html_id":"lets-look-at-the-labelled-feature-plotted-for-one-time-step","implicit":true,"key":"KTXS0w2ifK"}],"key":"Hzzt6CcPr7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s take a look at the labelled feature at time = 0 which at 2022 November 1 00:00 UTC along with precipitation overlay.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u4IQJjgAOQ"}],"key":"pruftZlWng"}],"key":"GOnFIjSikv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"t = 0\nslp = da.isel(time=t).values","key":"lVs7F8AIxM"},{"type":"outputs","id":"Z9fFcewt0QmcvoSEE1HZw","children":[],"key":"vZRbVIauyk"}],"key":"IZ1x13pCzF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We call the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KAErX0KGG5"},{"type":"inlineCode","value":"detect_features()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Dw0NMFyVV6"},{"type":"text","value":" function with the parameters set above","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fUFFKunByB"}],"key":"hP4T2JVRy9"}],"key":"QcLBOEhInA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"labels = detect_features(slp, threshold=threshold, min_area=min_area)","key":"vuB4iboFAG"},{"type":"outputs","id":"zAXk_PlxWY-2L0DIY1csZ","children":[],"key":"uUF3CEDBGC"}],"key":"PTGyVZYPNT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"levels = np.linspace(float(da.min()), float(da.max()), 16)\n\nfig, ax = plt.subplots(\n    figsize=(8, 4),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\n# colored SLP contour lines\nax.contour(\n    lon2d, lat2d, slp,\n    levels=levels,\n    cmap=\"turbo\",\n    linewidths=0.9,\n    transform=ccrs.PlateCarree()\n)\n\nax.contour(\n    lon2d,\n    lat2d,\n    labels.astype(int),\n    levels=[0.5],\n    colors=\"black\",\n    linewidths=1.6,\n    transform=ccrs.PlateCarree()\n)\n\nfor r in regionprops(labels):\n    y, x = r.centroid      # row, column\n    iy = int(round(y))\n    ix = int(round(x))\n\n\n    ax.plot(\n        lon[ix],\n        lat[iy],\n        \"ko\",\n        ms=3,\n        transform=ccrs.PlateCarree()\n    )\n\n    ax.text(\n        lon[ix],\n        lat[iy],\n        str(r.label),\n        fontsize=8,\n        color=\"black\",\n        ha=\"left\",\n        va=\"bottom\",\n        transform=ccrs.PlateCarree(),\n        bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n    )\n\n\nax.coastlines(color=\"0.55\", linewidth=0.6)\n\ngl = ax.gridlines(\n    draw_labels=True,\n    linewidth=0.4,\n    color=\"0.5\",\n    alpha=0.25,\n    linestyle=\"--\"\n)\ngl.top_labels = False\ngl.right_labels = False\n\n#ax.set_title(f\"Matplotlib contour-tracked SLP features | time index = {t}\")\n\nplt.show()\n","key":"qk42QIFjvH"},{"type":"outputs","id":"bD8mozaYlqIVj1dSHrZnj","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"91a769601dbcdf9b2a9bbbb04a3df4d9","path":"/feature-tracking-cookbook/build/91a769601dbcdf9b2a9bbbb04a3df4d9.png"}}},"key":"sQThnIY3Nv"}],"key":"IDrqvJgPqH"}],"key":"NlveQQEX0Z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s track SLP Features Over Time","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qQZt5JH9nF"}],"identifier":"lets-track-slp-features-over-time","label":"Let’s track SLP Features Over Time","html_id":"lets-track-slp-features-over-time","implicit":true,"key":"YJUPAxeJpN"}],"key":"be4hhRGbup"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We track the labelled SLP features from one time step to the next. Each detected feature is converted into a mask and compared with the masks from the previous time step. If a current feature overlaps strongly enough with a previous feature, it is treated as the same object and keeps the same track_id. If the overlap is too small, the feature is treated as a new object and is assigned a new track_id. For each time step, the code stores the feature ID, centroid location, and mask, which can later be used for plotting, animation, or further analysis of how the low-pressure systems move.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tnJEoB2mNy"}],"key":"k2aEfuU5kh"}],"key":"IWE4w9LeLf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"wAVlyVybZD"},{"type":"outputs","id":"GAOcj73Bbc92Nqap9nH9g","children":[],"key":"zScMpqfEIK"}],"key":"xmYQhnNvSY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s look at the animation of the SLP features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TvCCSAHaZZ"}],"identifier":"lets-look-at-the-animation-of-the-slp-features","label":"Let’s look at the animation of the SLP features","html_id":"lets-look-at-the-animation-of-the-slp-features","implicit":true,"key":"l8gzt3PA3Z"}],"key":"bzAuGtFwXX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    #ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"zVdjGQsgTw"},{"type":"outputs","id":"XNCOPNUynRvF-lx3cQR92","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":10,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"85785d4ca85aa8e979d59fc2fcc5728a","path":"/feature-tracking-cookbook/build/85785d4ca85aa8e979d59fc2fcc5728a.html"}}},"key":"cAOvhzB9BU"}],"key":"sZUazBgSEZ"}],"key":"pdCDXMFX2X"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This animation shows the evolution of SLP and precipitation through time using the overlap tracking method. The numeric annotations help follow individual systems across successive times, including cases where the detected object appears as nested within the larger low SLP features.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"THGvZHFmnE"}],"key":"zcHXma20tx"}],"key":"zmIwNPA7Eg"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"ZrVnWhi6is"}],"key":"NoXDlxzJBs"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The results may be ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DLWRpBzPES"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1