u1N"}],"key":"N5Ws4vxMIf"},{"type":"tableCell","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[],"key":"U1LR94EKvT"}],"key":"VnUt9k4xwo"},{"type":"tableRow","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"link","url":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"IPython","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Yh9nnmI0jb"}],"urlSource":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","key":"BM3k2Kh8mz"}],"key":"Mkpa6USna6"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Useful","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"PXEDWvtzCU"}],"key":"K0fZr0ANoC"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For inline animation","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"LJis50Mh36"}],"key":"NOy10SKdCI"}],"key":"w0G8mGcaCx"}],"key":"tzYODp8rF9"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Time to learn","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"x5WQwVEAqT"}],"key":"nlA3xiEeWg"},{"type":"text","value":": 30 minutes","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"v7Ec59DfDm"}],"key":"M25QKPEcRo"}],"key":"cqjDO9bEe4"}],"key":"Fl9SNgC9JJ"}],"key":"xHRGNYHpHd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nfrom matplotlib.animation import FuncAnimation\nfrom IPython.display import HTML\nfrom skimage.measure import label, regionprops\nimport matplotlib.colors as mcolors\nfrom matplotlib.cm import ScalarMappable\nimport cartopy.crs as ccrs","key":"Pwz7al8Wkh"},{"type":"outputs","id":"lFs-D9FuQzoKQvm9IZ0lD","children":[],"key":"faixCtNd2T"}],"key":"yvkBiXTqqu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\n\nds = xr.open_dataset(\"data/SLP_ex.nc\")\nda = ds[\"SLP\"]\n\nthreshold = 100000\nmin_area = 20\nmin_overlap = 0.2  \n\n\n\n# ---- get lat/lon coords ----\n# assumes dims like (time, lat, lon)\nlat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)\n","key":"T0U6kXAG65"},{"type":"outputs","id":"uWaHF8Lm3V2MaP85cMhW5","children":[],"key":"eVCIapNz4G"}],"key":"C1ubxskoFC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(field, threshold=100000, min_area=20):\n    mask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"pcpIqmuUYy"},{"type":"outputs","id":"Tbw07k2mu8_1ZOt-uY3bL","children":[],"key":"VmC9B0mBaq"}],"key":"LMmG0HUN36"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"qwNFmMaj3s"},{"type":"outputs","id":"W61zuYmxkAWGkzCvK6ilz","children":[],"key":"AJyCZmDXQv"}],"key":"B4rD3PK7V0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"ydnAQhdvpu"},{"type":"outputs","id":"wWVOUL-iA3aRSVMT2-n1Z","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"5cead3152d9b0a2cc7b83ab6f9e88a05","path":"/feature-tracking-cookbook/build/5cead3152d9b0a2cc7b83ab6f9e88a05.html"}}},"key":"GiHeecyZVT"}],"key":"Lj3oDE3fOf"}],"key":"fASZZmmFFe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Cm35xiYUCO"},{"type":"outputs","id":"cemH2ZEb5mhWT-zakcU-h","children":[],"key":"nRSVLplhO9"}],"key":"ifVrJQHrpH"}],"key":"Ay2BNEwNNN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Sea Level Pressure (SLP) Feature Tracking using SCIPY","url":"/notebooks/slp-scipy","group":"Sea Level Pressure Tracking"},"next":{"title":"Sea Level Pressure Identification and Tracking with Precipitation : Scikit","url":"/notebooks/scikit-slp-precip","group":"Combined Tracking"}}},"domain":"http://localhost:3000"}