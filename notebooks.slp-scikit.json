yyy"}],"key":"KjfsIYvmAd"},{"type":"tableCell","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[],"key":"TtsytpzBhA"}],"key":"du9noblrCl"},{"type":"tableRow","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"link","url":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"IPython","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"oNroUDut2m"}],"urlSource":"https://ipython.readthedocs.io/en/latest/interactive/plotting.html","key":"WDpFBBGKp2"}],"key":"oJ11d1EG6E"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Useful","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"mKjy52tWN9"}],"key":"Yj4pjCPi5j"},{"type":"tableCell","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"For inline animation","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"JWP07JQRZm"}],"key":"PmWWwEe2lz"}],"key":"kRfIWjnZEt"}],"key":"EmYNTXw5TT"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Time to learn","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"TT5gtkn1y5"}],"key":"PgQiTxZ72O"},{"type":"text","value":": 30 minutes","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"eA75ObKWN3"}],"key":"fsxXGlmuon"}],"key":"Vh2KPWIRLB"}],"key":"Se1wra0v2f"}],"key":"IoLC5t6Cq5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nfrom matplotlib.animation import FuncAnimation\nfrom IPython.display import HTML\nfrom skimage.measure import label, regionprops\nimport matplotlib.colors as mcolors\nfrom matplotlib.cm import ScalarMappable\nimport cartopy.crs as ccrs","key":"bkET90G07z"},{"type":"outputs","id":"JDsO_LIlSWDYhY6chUGFN","children":[],"key":"ZDZ5oMDm9q"}],"key":"YsDteYuPOz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"\n\nds = xr.open_dataset(\"data/SLP_ex.nc\")\nda = ds[\"SLP\"]\n\nthreshold = 100000\nmin_area = 20\nmin_overlap = 0.2  \n\n\n\n# ---- get lat/lon coords ----\n# assumes dims like (time, lat, lon)\nlat = da[da.dims[1]].values\nlon = da[da.dims[2]].values\n\n# if lat/lon are 1D, make 2D grids for contourf/contour\nlon2d, lat2d = np.meshgrid(lon, lat)\n","key":"Pp4qQIClKH"},{"type":"outputs","id":"iCFlNq5nae6yY9EGZlYSM","children":[],"key":"flBbp5OfJY"}],"key":"GfR1BPJxG4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def detect_features(field, threshold=100000, min_area=20):\n    mask = field <= threshold\n    labels = label(mask, connectivity=2)\n\n    for lab in np.unique(labels)[1:]:\n        if np.sum(labels == lab) < min_area:\n            labels[labels == lab] = 0\n\n    labels = label(labels > 0, connectivity=2)\n    return labels","key":"ExAXe4a1f4"},{"type":"outputs","id":"YCmL9hj9f3tizJXw2fbqL","children":[],"key":"gxBICd31KQ"}],"key":"dlpmWhxkB4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- precompute tracked features ----\ntracked = []\nprev = {}\nnext_track_id = 1\n\nfor t in range(da.sizes[\"time\"]):\n    field = da.isel(time=t).values\n    labels = detect_features(field, threshold=threshold, min_area=min_area)\n\n    current = {}\n    frame_info = []\n\n    for r in regionprops(labels):\n        mask = labels == r.label\n\n        best_id = None\n        best_overlap = 0.0\n\n        for track_id, old_mask in prev.items():\n            overlap = np.logical_and(mask, old_mask).sum() / mask.sum()\n            if overlap > best_overlap:\n                best_overlap = overlap\n                best_id = track_id\n\n        if best_overlap < min_overlap:\n            best_id = next_track_id\n            next_track_id += 1\n\n        current[best_id] = mask\n        frame_info.append({\n            \"track_id\": best_id,\n            \"centroid_rc\": r.centroid,   # row, col\n            \"mask\": mask\n        })\n\n    tracked.append(frame_info)\n    prev = current","key":"eL3G2ckhym"},{"type":"outputs","id":"D1m5xy9uNbuqzZurKqscR","children":[],"key":"RI9Max8X4q"}],"key":"qxTnUh160n"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---- color scale fixed across all frames ----\nvmin = float(da.min())\nvmax = float(da.max())\nlevels = np.linspace(vmin, vmax, 16)\nnorm = mcolors.Normalize(vmin=vmin, vmax=vmax)\ncmap = \"turbo\"\n\n\n# ---- animate ----\nfig, ax = plt.subplots(figsize=(8, 4), subplot_kw={\"projection\": ccrs.PlateCarree()})\n\nsm = ScalarMappable(norm=norm, cmap=cmap)\nsm.set_array([])\ncbar = fig.colorbar(sm, ax=ax, pad=0.02)\ncbar.set_label(\"SLP\")\n\n\ndef update(t):\n    ax.clear()\n\n    field = da.isel(time=t).values\n\n    # SLP as colored contour lines, not filled\n    cs = ax.contour(\n        lon2d, lat2d, field,\n        levels=levels,\n        cmap=\"turbo\",          # or \"rainbow\", \"viridis\", \"plasma\"\n        linewidths=0.9,\n        transform=ccrs.PlateCarree()\n    )\n\n    # tracked feature outlines + labels\n    for feat in tracked[t]:\n        mask = feat[\"mask\"]\n\n        ax.contour(\n            lon2d, lat2d, mask.astype(int),\n            levels=[0.5],\n            colors=\"black\",\n            linewidths=1.6,\n            transform=ccrs.PlateCarree()\n        )\n\n        y, x = feat[\"centroid_rc\"]\n        iy = int(round(y))\n        ix = int(round(x))\n\n        ax.plot(\n            lon[ix], lat[iy],\n            \"ko\", ms=3,\n            transform=ccrs.PlateCarree()\n        )\n\n        ax.text(\n            lon[ix], lat[iy],\n            str(feat[\"track_id\"]),\n            fontsize=8,\n            color=\"black\",\n            ha=\"left\",\n            va=\"bottom\",\n            transform=ccrs.PlateCarree(),\n            bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.7, pad=1)\n        )\n\n    # continents/coastlines: faint, not black\n    ax.coastlines(color=\"0.55\", linewidth=0.6)\n\n    # faint gridlines\n    gl = ax.gridlines(\n        draw_labels=True,\n        linewidth=0.4,\n        color=\"0.5\",\n        alpha=0.25,\n        linestyle=\"--\"\n    )\n    gl.top_labels = False\n    gl.right_labels = False\n\n    ax.set_title(f\"Scikit tracked SLP features | time index = {t}\")\n\nanim = FuncAnimation(\n    fig,\n    update,\n    frames=da.sizes[\"time\"],\n    interval=300,\n    blit=False,\n)\n\nplt.close(fig)\nHTML(anim.to_jshtml())","key":"iRjpwBexn7"},{"type":"outputs","id":"V2PSYlYCQ19DkVmHcVUCt","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"f39fede70322eb2ffa2a1e00560a61ec","path":"/feature-tracking-cookbook/build/f39fede70322eb2ffa2a1e00560a61ec.html"}}},"key":"PnzakiPMSO"}],"key":"Sl1I3EiJWh"}],"key":"M2pvWJ11dF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"OEimxbHxgw"},{"type":"outputs","id":"LznE8rReCCd2PDRe0l7Dp","children":[],"key":"ec148CveX8"}],"key":"jeW3De9NOV"}],"key":"MPz3k3YI7G"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Sea Level Pressure (SLP) Feature Tracking using SCIPY","url":"/notebooks/slp-scipy","group":"Sea Level Pressure Tracking"},"next":{"title":"Sea Level Pressure Identification and Tracking with Precipitation : Scikit","url":"/notebooks/scikit-slp-precip","group":"Combined Tracking"}}},"domain":"http://localhost:3000"}